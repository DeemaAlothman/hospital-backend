@startuml Admin_Staff
title ADMIN — Users / Patients / Doctors

left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam ranksep 60
skinparam nodesep 30
skinparam usecase {
  BackgroundColor #FFF4EE
  BorderColor #D9734A
  FontSize 12
}
skinparam package {
  BackgroundColor #FFFBF9
  BorderColor #D9734A
  FontSize 13
  FontStyle bold
}

actor "Admin" as A #D9734A

package "Users" {
  (عرض المستخدمين)
  (إضافة مستخدم)
  (تعديل مستخدم)
  (حذف مستخدم)
}

package "Patients" {
  (عرض المرضى)
  (إضافة مريض)
  (تعديل مريض)
  (حذف مريض)
}

package "Doctors" {
  (عرض الأطباء)
  (إضافة طبيب)
  (تعديل طبيب)
  (حذف طبيب)
}

A --> (عرض المستخدمين)
A --> (إضافة مستخدم)
A --> (تعديل مستخدم)
A --> (حذف مستخدم)

A --> (عرض المرضى)
A --> (إضافة مريض)
A --> (تعديل مريض)
A --> (حذف مريض)

A --> (عرض الأطباء)
A --> (إضافة طبيب)
A --> (تعديل طبيب)
A --> (حذف طبيب)

@enduml

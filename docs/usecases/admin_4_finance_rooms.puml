left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam ranksep 60
skinparam nodesep 30
skinparam usecase {
  BackgroundColor #FFF4EE
  BorderColor #D9734A
  FontSize 12
}
skinparam package {
  BackgroundColor #FFFBF9
  BorderColor #D9734A
  FontSize 13
  FontStyle bold
}

actor "Admin" as A #D9734A

package "Invoices" {
  (عرض جميع الفواتير)
  (إنشاء فاتورة)
  (إضافة بند لفاتورة)
  (تحصيل فاتورة)
  (إلغاء فاتورة)
  (عرض إحصائيات الأقسام)
